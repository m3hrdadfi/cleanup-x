APP_ENV=development
# Use only with a separate synthetic database. Disables X OAuth, sync, and writes.
APP_DEMO_MODE=false
APP_DATABASE_URL=sqlite:///./data/cleanup-x.db
APP_ENCRYPTION_KEY=
APP_FRONTEND_URL=http://127.0.0.1:5173
APP_API_URL=http://127.0.0.1:8787
APP_X_CLIENT_ID=
APP_X_CLIENT_SECRET=
APP_X_CALLBACK_URL=http://127.0.0.1:8787/api/auth/x/callback
APP_MAX_ARCHIVE_MB=2048
APP_MAX_ARCHIVE_FILES=20000
APP_API_BUDGET_USD=25
# Local cost estimates, editable in Settings. Check your X console for actual billing.
APP_DELETE_UNIT_COST_USD=0.01
APP_OWNED_READ_UNIT_COST_USD=0.001
APP_POST_LOOKUP_UNIT_COST_USD=0.005
APP_LLM_PROVIDER=ollama
APP_LLM_BASE_URL=http://127.0.0.1:11434
APP_LLM_MODEL=qwen2.5:7b
APP_LLM_API_KEY=
APP_LLM_TIMEOUT_SECONDS=120
APP_LLM_BATCH_SIZE=10
APP_LLM_VISION_ENABLED=false
# Semantic search uses a separate embedding model (not the chat model).
# For compatible APIs include /v1 in BASE_URL yourself when required.
APP_EMBEDDING_PROVIDER=ollama
APP_EMBEDDING_BASE_URL=http://127.0.0.1:11434
APP_EMBEDDING_MODEL=
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_TIMEOUT_SECONDS=120
APP_EMBEDDING_BATCH_SIZE=16
# Optional model-specific task prefixes. Preserve trailing spaces with quotes.
APP_EMBEDDING_QUERY_PREFIX=""
APP_EMBEDDING_DOCUMENT_PREFIX=""
